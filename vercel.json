{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kabafence.com" }],
      "destination": "https://kabafence.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "kaba-platform.vercel.app" }],
      "destination": "https://kabafence.com/:path",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kabateam.com" }],
      "destination": "https://kabafence.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kabateam.com" }],
      "destination": "https://kabafence.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/quiet-digest",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/visit-reminders",
      "schedule": "15 12 * * *"
    }
  ]
}
