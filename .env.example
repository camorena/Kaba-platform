# Optional — Plausible analytics domain
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=kabafence.com

# Admin scaffold password (REQUIRED to sign in at /admin/login)
# WARNING: cookie stub only — NOT production auth.
ADMIN_PASSWORD=change-me-before-sharing

# Optional ops note shown in Settings → Security (documentation only — not a role grant).
# ADMIN_ROLES_DOC=Owner: Alice. Editors TBD after Auth.js.

# Data adapter: memory (default) | postgres (not implemented yet — see db/migrations)
# KABA_DATA_ADAPTER=memory
# DATABASE_URL=  # required only when postgres adapter is implemented

# Payments — NOT wired yet. Documented on /admin/settings.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
